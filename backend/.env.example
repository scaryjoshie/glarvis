# LLM (OpenAI-compatible)
LLM_API_KEY=your_api_key
LLM_BASE_URL=               # optional, defaults to OpenAI
LLM_MODEL=gpt-4o-mini

# Speech-to-Text (OpenAI-compatible)
STT_API_KEY=your_api_key
STT_BASE_URL=               # optional, defaults to OpenAI
STT_MODEL=gpt-4o-transcribe

# Text-to-Speech (OpenAI-compatible)
TTS_API_KEY=your_api_key
TTS_BASE_URL=               # optional, defaults to OpenAI
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
